# Model provider: "ollama" (fully offline, default) or "openai"
LLM_PROVIDER=ollama

# --- Ollama (offline) ---
OLLAMA_BASE_URL=http://localhost:11434
# AGENT_MODEL=qwen2.5:7b-instruct
# JUDGE_MODEL=qwen3:14b
# EMBED_MODEL=nomic-embed-text

# --- OpenAI ---
# If LLM_PROVIDER=openai and this is empty, you will be prompted securely (getpass) at startup.
# OPENAI_API_KEY=
# AGENT_MODEL=gpt-4o-mini
# JUDGE_MODEL=gpt-4o
# EMBED_MODEL=text-embedding-3-small

# --- Runtime knobs ---
# RAG_TOP_K=3
# RECURSION_LIMIT=12
# MAX_INPUT_CHARS=4000
# API_HOST=127.0.0.1
# API_PORT=8000
# CORS_ORIGINS=http://localhost:5173,http://127.0.0.1:5173
